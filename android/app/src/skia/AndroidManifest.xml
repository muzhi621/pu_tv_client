<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Merged only into the skia variant. Keeps Impeller enabled but forces its
         OpenGL ES backend: on boxes with broken Vulkan drivers this avoids the
         Vulkan artifacts, without taking the deprecated `--enable-impeller=false`
         (legacy Skia) path that Flutter 3.50 removed and that black-screens. -->
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="opengl" />
    </application>
</manifest>
